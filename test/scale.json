{
  "name": "CI/CD — Scale Test",
  "application": "CI_CD_Application",
  "start": false,
  "timeout": 10000,
  "tests": [
    {
      "name": "FB_Scale — 400 → 40",
      "description": "Scale 0..1000 raw to 0..100 scaled",
      "timeout": 5000,
      "steps": [
        {"action": "write", "variable": "MAIN.fbScale.rRaw", "value": 400.0},
        {"action": "write", "variable": "MAIN.fbScale.rRawMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rRawMax", "value": 1000.0},
        {"action": "write", "variable": "MAIN.fbScale.rScaledMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rScaledMax", "value": 100.0},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": true},
        {"action": "wait", "ms": 200},
        {"action": "assert", "variable": "MAIN.fbScale.xDone", "expected": true},
        {"action": "read", "variable": "MAIN.fbScale.rResult", "expected": 40.0, "tolerance": 0.001},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": false}
      ]
    },
    {
      "name": "FB_Scale — clamp low",
      "description": "Raw below min clamps to scaled min",
      "timeout": 5000,
      "steps": [
        {"action": "write", "variable": "MAIN.fbScale.rRaw", "value": -100.0},
        {"action": "write", "variable": "MAIN.fbScale.rRawMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rRawMax", "value": 1000.0},
        {"action": "write", "variable": "MAIN.fbScale.rScaledMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rScaledMax", "value": 100.0},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": true},
        {"action": "wait", "ms": 200},
        {"action": "read", "variable": "MAIN.fbScale.rResult", "expected": 0.0, "tolerance": 0.001},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": false}
      ]
    },
    {
      "name": "FB_Scale — clamp high",
      "description": "Raw above max clamps to scaled max",
      "timeout": 5000,
      "steps": [
        {"action": "write", "variable": "MAIN.fbScale.rRaw", "value": 1500.0},
        {"action": "write", "variable": "MAIN.fbScale.rRawMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rRawMax", "value": 1000.0},
        {"action": "write", "variable": "MAIN.fbScale.rScaledMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rScaledMax", "value": 100.0},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": true},
        {"action": "wait", "ms": 200},
        {"action": "read", "variable": "MAIN.fbScale.rResult", "expected": 100.0, "tolerance": 0.001},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": false}
      ]
    }
  ]
}
