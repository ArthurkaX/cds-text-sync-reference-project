{
  "name": "CI/CD — Scale Test",
  "application": "CI_CD_Application",
  "start": false,
  "timeout": 10000,
  "reset": "cold",
  "tests": [
    {
      "name": "FB_Scale — 400 → 40",
      "description": "Normal scaling: 0..1000 → 0..100, input 400 → output 40",
      "timeout": 5000,
      "steps": [
        {"action": "write", "variable": "MAIN.fbScale.rInput", "value": 400.0},
        {"action": "write", "variable": "MAIN.fbScale.rInputMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rInputMax", "value": 1000.0},
        {"action": "write", "variable": "MAIN.fbScale.rOutputMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rOutputMax", "value": 100.0},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": true},
        {"action": "wait", "ms": 200},
        {"action": "assert", "variable": "MAIN.fbScale.xDone", "expected": true},
        {"action": "read", "variable": "MAIN.fbScale.rResult", "expected": 40.0, "tolerance": 0.001},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": false}
      ]
    },
    {
      "name": "FB_Scale — clamp low",
      "description": "rInput=-100, min=0 → clamp to 0",
      "timeout": 5000,
      "steps": [
        {"action": "write", "variable": "MAIN.fbScale.rInput", "value": -100.0},
        {"action": "write", "variable": "MAIN.fbScale.rInputMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rInputMax", "value": 1000.0},
        {"action": "write", "variable": "MAIN.fbScale.rOutputMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rOutputMax", "value": 100.0},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": true},
        {"action": "wait", "ms": 200},
        {"action": "read", "variable": "MAIN.fbScale.rResult", "expected": 0.0, "tolerance": 0.001},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": false}
      ]
    },
    {
      "name": "FB_Scale — clamp high",
      "description": "rInput=9999, max=1000 → clamp to 100%",
      "timeout": 5000,
      "steps": [
        {"action": "write", "variable": "MAIN.fbScale.rInput", "value": 9999.0},
        {"action": "write", "variable": "MAIN.fbScale.rInputMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rInputMax", "value": 1000.0},
        {"action": "write", "variable": "MAIN.fbScale.rOutputMin", "value": 0.0},
        {"action": "write", "variable": "MAIN.fbScale.rOutputMax", "value": 100.0},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": true},
        {"action": "wait", "ms": 200},
        {"action": "read", "variable": "MAIN.fbScale.rResult", "expected": 100.0, "tolerance": 0.001},
        {"action": "write", "variable": "MAIN.fbScale.xExecute", "value": false}
      ]
    }
  ]
}
